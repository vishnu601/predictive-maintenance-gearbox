# Predictive Maintenance Platform Configuration
ENV=development
LOG_LEVEL=INFO

# Application
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/monitoring.db

# Live Serial Sensor Integration
SERIAL_PORT=/dev/tty.usbserial-0001
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT_SEC=1.0

# Sampling & Processing
SAMPLING_RATE_HZ=5000
WINDOW_SIZE=2048
OVERLAP_PERCENT=50
